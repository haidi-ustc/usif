[flake8]
max-line-length = 100
exclude = .git,__pycache__,build,dist,*.egg-info,.venv,venv,.tox,.pytest_cache,htmlcov,.mypy_cache,.eggs,work
extend-ignore = E203, W503, E501
max-complexity = 20
per-file-ignores =
    __init__.py:F401
    tests/*:F401,F811,E501,E303
    tests/conftest.py:E402,F401
    examples/*.py:E402
    examples/example-1.py:E402,C901
    examples/example-2.py:E402,C901
    usif/format/properties.py:C901
    usif/properties/serializer.py:C901
    usif/interop/converter_core.py:C901
    usif/storage/container.py:C901
    usif/utils/mp_downloader.py:C901
    usif/symmetry/equivalence.py:E302,W391
    usif/symmetry/reduce.py:E302
    usif/structures/structure.py:W391
import-order-style = google
