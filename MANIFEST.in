include README.md
include LICENSE
include pyproject.toml
include docs/ARCHITECTURE.md
include docs/FORMAT_VERSIONING.md
include docs/API_STABILITY.md
include docs/BINARY_FORMAT.md
include docs/CHANGELOG.md
include docs/CONTAINER_FORMAT.md
include docs/CONTRIBUTING.md
include docs/PROPERTY_SYSTEM.md
include docs/RELEASE.md
include docs/TESTING.md
include docs/VERSIONING.md
recursive-include examples *.py *.md
recursive-include scripts *.py
recursive-include tests *.py
recursive-include tests/fixtures *.zip
recursive-exclude docs/archive *
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * *.so
recursive-exclude * .DS_Store
recursive-exclude * .pytest_cache
recursive-exclude build *
recursive-exclude dist *
recursive-exclude *.egg-info *

recursive-include .github/workflows *.yml
